<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <id>io.github.b1ngggg.netease_cloud_music_linux.cloudplayer</id>
    <developer id="io.github.b1ngggg">
        <name>b1ngggg</name>
    </developer>
    <metadata_license>CC0-1.0</metadata_license>
    <project_license>GPL-3.0-or-later</project_license>
    <releases>
        <release version="1.0.1" date="2026-05-28" type="stable" />
    </releases>
    <name>Cloud Player</name>
    <summary>Unofficial Linux desktop client for NetEase Cloud Music</summary>
    <url type="homepage">https://github.com/b1ngggg/netease-cloud-music-linux</url>
    <url type="vcs-browser">https://github.com/b1ngggg/netease-cloud-music-linux</url>
    <recommends>
        <control>pointing</control>
        <control>keyboard</control>
    </recommends>
    <description>
        <p>Cloud Player is an unofficial Linux desktop client based on NetEase Cloud Music Gtk, with a redesigned UI, comments, and performance optimizations.</p>
        <p>The original upstream project is NetEase Cloud Music Gtk.</p>
        <p>This project is not affiliated with NetEase Cloud Music.</p>
    </description>
    <screenshots>
        <screenshot type="default">
            <image>https://raw.githubusercontent.com/b1ngggg/netease-cloud-music-linux/v1.0.1/screenshots/discover.jpg</image>
        </screenshot>
        <screenshot>
            <image>https://raw.githubusercontent.com/b1ngggg/netease-cloud-music-linux/v1.0.1/screenshots/lyrics.png</image>
        </screenshot>
        <screenshot>
            <image>https://raw.githubusercontent.com/b1ngggg/netease-cloud-music-linux/v1.0.1/screenshots/queue.png</image>
        </screenshot>
        <screenshot>
            <image>https://raw.githubusercontent.com/b1ngggg/netease-cloud-music-linux/v1.0.1/screenshots/comments.png</image>
        </screenshot>
        <screenshot>
            <image>https://raw.githubusercontent.com/b1ngggg/netease-cloud-music-linux/v1.0.1/screenshots/daily-recommendation.png</image>
        </screenshot>
    </screenshots>
    <content_rating type="oars-1.1" />
    <launchable type="desktop-id">io.github.b1ngggg.netease_cloud_music_linux.cloudplayer.desktop</launchable>
</component>
