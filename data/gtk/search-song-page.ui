<?xml version="1.0" encoding="UTF-8"?>
<interface>
    <requires lib="gtk" version="4.0" />
    <template class="SearchSongPage" parent="GtkBox">
        <property name="valign">fill</property>
        <property name="halign">fill</property>
        <property name="orientation">vertical</property>
        <property name="spacing">20</property>
        <style>
            <class name="app-page" />
            <class name="search-song-page" />
        </style>
        <child>
            <object class="AdwClamp" id="title_clamp">
                <property name="hexpand">true</property>
                <property name="margin-top">22</property>
                <property name="margin-start">20</property>
                <property name="margin-end">20</property>
                <property name="maximum-size">1000</property>
                <property name="tightening-threshold">730</property>
                <child>
                    <object class="GtkBox">
                        <property name="halign">fill</property>
                        <property name="valign">fill</property>
                        <property name="hexpand">true</property>
                        <property name="orientation">horizontal</property>
                        <property name="spacing">12</property>
                        <style>
                            <class name="app-search-results-hero" />
                        </style>
                        <child>
                            <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="halign">fill</property>
                                <property name="valign">end</property>
                                <property name="hexpand">true</property>
                                <property name="spacing">10</property>
                                <child>
                                    <object class="GtkLabel">
                                        <property name="label">搜索结果</property>
                                        <property name="halign">start</property>
                                        <style>
                                            <class name="app-eyebrow" />
                                        </style>
                                    </object>
                                </child>
                                <child>
                                    <object class="GtkLabel" id="title_label">
                                        <property name="label">标题</property>
                                        <property name="halign">start</property>
                                        <property name="valign">end</property>
                                        <property name="max-width-chars">27</property>
                                        <property name="ellipsize">end</property>
                                        <style>
                                            <class name="app-detail-title" />
                                        </style>
                                    </object>
                                </child>
                                <child>
                                    <object class="GtkBox">
                                        <property name="halign">fill</property>
                                        <property name="valign">end</property>
                                        <property name="spacing">7</property>
                                        <property name="orientation">horizontal</property>
                                        <child>
                                            <object class="GtkLabel" id="num_label">
                                                <property name="label">0 首歌曲</property>
                                                <property name="halign">start</property>
                                                <property name="valign">end</property>
                                                <style>
                                                    <class name="app-muted-label" />
                                                </style>
                                            </object>
                                        </child>
                                        <child>
                                            <object class="GtkButton" id="play_button">
                                                <property name="halign">end</property>
                                                <property name="valign">center</property>
                                                <property name="hexpand">true</property>
                                                <property name="icon-name">media-playback-start-symbolic</property>
                                                <signal name="clicked" handler="play_button_clicked_cb" swapped="true" />
                                                <property name="tooltip-text">播放列表</property>
                                                <style>
                                                    <class name="circular" />
                                                    <class name="app-primary-play" />
                                                </style>
                                            </object>
                                        </child>
                                    </object>
                                </child>
                            </object>
                        </child>
                    </object>
                </child>
            </object>
        </child>
        <child>
            <object class="SongListView" id="songs_list"></object>
        </child>
    </template>
</interface>
