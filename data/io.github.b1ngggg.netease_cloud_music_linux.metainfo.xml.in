    <name>NetEase Cloud Music Linux</name>
    <summary>Linux desktop client based on NetEase Cloud Music Gtk</summary>
    <url type="homepage">https://github.com/b1ngggg/netease-cloud-music-linux</url>
    <url type="vcs-browser">https://github.com/gmg137/netease-cloud-music-gtk</url>
    <recommends>
        <control>pointing</control>
        <control>keyboard</control>
    </recommends>
    <description>
        <p>NetEase Cloud Music Linux is a Linux desktop client based on NetEase Cloud Music Gtk, with a redesigned UI, comments, and performance optimizations.</p>
    </description>
